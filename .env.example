# 변수 이름만 적어요. 실제 값은 .env.local(커밋 안 함)·배포 환경·GitHub Secrets에 넣어요.
# docker·CI·주최 측 실행은 docker-compose.yml의 environment 값을 씁니다.

# --- 서비스 ---
# 서비스 AI 기능(사진 인식·비타민 추천)용 Vercel AI Gateway 키. 비어 있어도 앱은 뜹니다.
AI_GATEWAY_API_KEY=
# PostgreSQL 연결 주소. 비어 있으면 로컬 개발용 내장 DB(PGlite, .pglite/)를 씁니다.
# Supabase: Project Settings → Database → Connection string → Transaction pooler(포트 6543) 주소에 DB 비밀번호를 넣은 것.
DATABASE_URL=
# 자체 인증서로 SSL을 받는 DB(Supabase 등)의 CA 인증서(PEM 전체, 줄바꿈은 \n으로 써도 됨). 넣으면 인증서를 검증하며 붙습니다.
# Supabase: Project Settings → Database → SSL Configuration → Download certificate 파일 내용.
DATABASE_SSL_CA=
# 로그인 쿠키 서명 키(16자 이상). 비어 있으면 서버를 켤 때마다 임의 값(로그인이 풀림).
SESSION_SECRET=
# E2E용 `데모` 시드 계정(첫 검진 완료, 비맥스제트정 보유). docker-compose.yml과 같은 값을 쓰면 로컬에서도 같은 계정으로 들어갈 수 있어요.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# 가상 페르소나 데모 계정(data/seed/personas.json)의 공통 비밀번호. 비우면 페르소나 계정을 만들지 않아요.
SEED_PERSONA_PASSWORD=
# AI 모델 식별자(선택). 비우면 코드의 기본값(data/seed/README.md 'AI 모델' 절)을 씁니다.
AI_VISION_MODEL=
AI_TEXT_MODEL=
# 배포 commit SHA. /__health의 releaseId로 응답. docker 빌드 인자·Vercel 환경변수로 들어옵니다.
RELEASE_ID=

# --- 데이터 준비용(앱 실행과 무관) ---
# scripts/fetch_easy_drug_api.py: 공공데이터포털 e약은요 OpenAPI 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
